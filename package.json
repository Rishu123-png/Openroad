{
  "name": "openroad",
  "version": "0.1.0",
  "private": true,
  "description": "OPENROAD - browser-based open-world driving and social game",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @openroad/web",
    "build": "npm run build --workspace @openroad/web",
    "preview": "npm run preview --workspace @openroad/web",
    "typecheck": "npm run typecheck --workspace @openroad/web",
    "test": "npm run test --workspace @openroad/web",
    "test:unit": "npm run test --workspace @openroad/web",
    "test:tools": "node --test tools/inspect-osm.test.mjs tools/geodata.test.mjs tools/district.test.mjs",
    "test:real": "npm run test:real --workspace @openroad/web",
    "test:smoke": "node tools/smoke/browser-smoke.mjs",
    "audit:district": "node tools/audit-district.mjs",
    "check": "npm run typecheck && npm run test:unit && npm run test:tools && npm run build"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0"
  }
}
